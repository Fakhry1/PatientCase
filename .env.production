# Production Environment Variables
# يجب إضافة هذه المتغيرات في Vercel Dashboard > Settings > Environment Variables

# Backend API Base URL
API_REMOTE_BASE_URL=https://doctor-telemedicine-server.vercel.app/api/v1

# Authentication Header Name
API_AUTH_HEADER=x-auth-token

# Authentication Token Value (احصل عليه من مسؤول الـ backend)
API_AUTH_VALUE=

# Optional: Bearer Token (استخدمه فقط إذا كان الـ backend يتطلب Bearer auth)
API_BEARER_TOKEN=

# Optional: Public API Root (للاستخدام من المتصفح فقط عند الحاجة)
VITE_PUBLIC_API_ROOT=

# UploadThing Proxy URL (اختياري - يستخدم القيمة الافتراضية إذا لم يُحدد)
UPLOADTHING_PROXY_URL=

# UploadThing Secret (غير مستخدم حالياً - المشروع يعتمد على proxy خارجي)
UPLOADTHING_SECRET=
